; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="I Will Get It"
config/description="A lovesick hero promises the impossible. A thousand-year comet makes him do it."
config/version="0.0.1"
run/main_scene="res://scenes/levels/test_gym/test_gym.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/autoload/settings.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83), Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68), Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0)]
}
look_left={
"deadzone": 0.15,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":-1.0)]
}
look_right={
"deadzone": 0.15,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":1.0)]
}
look_up={
"deadzone": 0.15,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":-1.0)]
}
look_down={
"deadzone": 0.15,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":1.0)]
}
jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32), Object(InputEventJoypadButton,"device":-1,"button_index":0)]
}
sprint={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194325), Object(InputEventJoypadButton,"device":-1,"button_index":7)]
}
crouch={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194326), Object(InputEventKey,"device":-1,"physical_keycode":67), Object(InputEventJoypadButton,"device":-1,"button_index":1), Object(InputEventJoypadButton,"device":-1,"button_index":8)]
}
aim={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":2), Object(InputEventJoypadMotion,"device":-1,"axis":4,"axis_value":1.0)]
}
emote={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":66), Object(InputEventJoypadButton,"device":-1,"button_index":12)]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305), Object(InputEventJoypadButton,"device":-1,"button_index":6)]
}
toggle_debug={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194334)]
}

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
